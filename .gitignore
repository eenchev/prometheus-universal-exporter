.DS_Store
.AppleDouble
.LSOverride

# Environment and local secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Go build and test artifacts
/prometheus-universal-exporter
/pue-allocator
bin/
dist/
*.test
coverage.out
coverage.html
*.out
*.prof
*.log

# Local configuration and editor files
config.local.yaml
config.*.local.yaml
.idea/
.vscode/

# Files Claude (Cowork) leaves in the working copy for review
/Claude outputs/

# Dependencies are fetched from the module proxy against go.sum; a vendor
# directory made with `go mod vendor` (to work offline) is local only.
/vendor/

# Packaged Helm charts are build output; the release workflow packages the
# chart from source and pushes it to GHCR.
*.tgz
