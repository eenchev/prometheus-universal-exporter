{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "prometheus-universal-exporter values",
  "description": "Values accepted by the prometheus-universal-exporter chart. Every value has a default, so nothing here is required; the schema exists to catch a typo or a wrong type while rendering rather than after the pod is scheduled. Values that pass a raw Kubernetes shape straight through stay open, so a field Kubernetes gains does not need a chart release.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 0},
    "namespaceOverride": {"type": "string"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "defaultLabels": {"$ref": "#/$defs/stringMap"},
    "defaultAnnotations": {"$ref": "#/$defs/stringMap"},

    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"name": {"type": "string"}},
        "required": ["name"]
      }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "automount": {"type": "boolean"},
        "annotations": {"$ref": "#/$defs/stringMap"},
        "name": {"type": "string"}
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]},
        "port": {"$ref": "#/$defs/port"},
        "sessionAffinity": {"enum": ["", "None", "ClientIP"]},
        "annotations": {"$ref": "#/$defs/stringMap"}
      }
    },

    "neg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"$ref": "#/$defs/stringMap"}
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"$ref": "#/$defs/stringMap"},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "pathType": {"enum": ["Exact", "Prefix", "ImplementationSpecific"]}
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "hosts": {"type": "array", "items": {"type": "string"}},
              "secretName": {"type": "string"}
            }
          }
        }
      }
    },

    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listenAddress": {
          "type": "string",
          "description": "host:port. A bare port is rejected here and again while rendering, because Go accepts the flag and then fails to listen with \"missing port in address\".",
          "pattern": "^([^:]*|\\[[0-9A-Fa-f:.]+\\]):[0-9]+$"
        },
        "pythonPath": {"type": "string", "minLength": 1},
        "watchConfig": {"type": "boolean"},
        "watchConfigInterval": {"allOf": [{"$ref": "#/$defs/duration"}, {"pattern": "[1-9]"}], "description": "Rendered as --config.watch-interval: a positive Go duration, such as 60s or 1m30s."},
        "expandEnv": {"type": "boolean"},
        "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"], "description": "Rendered as --log.level."},
        "enableLifecycle": {"type": "boolean", "description": "Rendered as --web.enable-lifecycle when true: enables POST /-/reload."},
        "probeDebug": {"type": "boolean", "description": "Rendered as --web.enable-probe-debug when true: enables /probe?debug=true."},
        "probeTimeoutOffset": {
          "type": "string",
          "description": "Rendered as --probe.timeout-offset when set: how much of Prometheus's scrape timeout a probe leaves unused. Empty keeps the exporter's default, 500ms.",
          "pattern": "^$|^(0|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)$"
        },
        "probeDefaultTimeout": {
          "type": "string",
          "description": "Rendered as --probe.default-timeout when set: how long a probe without a scrape timeout header may take, whatever timeout parameter it gives. Empty keeps the exporter's default, 30s; 0 leaves such a probe unbounded.",
          "pattern": "^$|^(0|([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+)$"
        },
        "probeMaxConcurrent": {
          "type": ["string", "integer", "null"],
          "description": "Rendered as --probe.max-concurrent when set: how many trips to targets, of every collector together, may be in progress at once. 0 or empty leaves them bounded only per collector.",
          "pattern": "^$|^[0-9]+$",
          "minimum": 0
        },
        "pythonMaxWorkers": {
          "type": ["string", "integer", "null"],
          "description": "Rendered as --python.max-workers when set: how many Python workers, of every collector together, may be alive at once. 0 or empty leaves them bounded only per script.",
          "pattern": "^$|^[0-9]+$",
          "minimum": 0
        },
        "shutdownTimeout": {
          "type": "string",
          "description": "Rendered as --web.shutdown-timeout when set: how long a stopping pod waits for the probes in progress. Whole hours, minutes and seconds, such as 30s or 1m30s. Empty keeps the exporter's default, 15s.",
          "pattern": "^$|^([0-9]+h)?([0-9]+m)?([0-9]+s)?$"
        },
        "shutdownDelay": {
          "type": "string",
          "description": "Rendered as --web.shutdown-delay when set: how long a stopping pod keeps serving, with /ready answering 503, before the graceful shutdown begins, so Kubernetes takes it out of the Service first. Whole hours, minutes and seconds, such as 5s; 0s turns it off. Empty leaves the flag out.",
          "pattern": "^$|^([0-9]+h)?([0-9]+m)?([0-9]+s)?$"
        }
      }
    },

    "terminationGracePeriodSeconds": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "The pod's terminationGracePeriodSeconds. Null keeps Kubernetes' 30 unless the shutdown needs more; set, it must be at least server.shutdownDelay plus server.shutdownTimeout plus 10 seconds."
    },

    "env": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
    "envFrom": {"type": "array", "items": {"type": "object"}},

    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "A whole command-line argument. A flag the chart already renders is rejected while rendering, because Go keeps the last occurrence and the entry would silently win.",
        "pattern": "^--"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "mountPath": {"type": "string"}, "readOnly": {"type": "boolean"}, "subPath": {"type": "string"}},
        "required": ["name", "mountPath"]
      }
    },

    "staticTargets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "description": "Render the static target document and pass it with --static-targets-file."},
        "fileName": {"type": "string", "description": "The static target file's key in the configuration ConfigMap.", "pattern": "^[-._a-zA-Z0-9]+$", "not": {"enum": [".", ".."]}},
        "path": {
          "type": "string",
          "description": "Rendered as --web.static-targets-path: where the static targets' latest results are served. A path of plain segments that no other endpoint uses, and not selfMetrics.path.",
          "pattern": "^(/[A-Za-z0-9._~-]*[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+$",
          "not": {"enum": ["/probe", "/health", "/ready", "/collectors", "/-/reload"]}
        },
        "data": {"type": "string", "description": "The static target document, YAML."},
        "expandEnv": {"type": "boolean", "description": "Rendered as --static-targets.expand-env with enabled: expands ${NAME} environment references in the static target document."},
        "monitor": {
          "type": "object",
          "additionalProperties": false,
          "description": "The ServiceMonitor or PodMonitor scraping the static targets endpoint.",
          "properties": {
            "enabled": {"type": "boolean"},
            "type": {"type": "string", "enum": ["service", "pod"]},
            "interval": {"$ref": "#/$defs/duration"},
            "scrapeTimeout": {"$ref": "#/$defs/duration"},
            "labels": {"$ref": "#/$defs/stringMap"},
            "annotations": {"$ref": "#/$defs/stringMap"},
            "relabelings": {"type": "array", "items": {"type": "object"}},
            "metricRelabelings": {"type": "array", "items": {"type": "object"}},
            "targets": {
              "type": "array",
              "description": "Static targets this monitor reads, rendered as the endpoint's targets parameter; empty reads every target.",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"}
            }
          }
        }
      }
    },

    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "data": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },

    "monitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "type": {"enum": ["service", "pod"]},
          "interval": {"$ref": "#/$defs/duration"},
          "scrapeTimeout": {"$ref": "#/$defs/duration"},
          "labels": {"$ref": "#/$defs/stringMap"},
          "annotations": {"$ref": "#/$defs/stringMap"},
          "targetSelector": {"type": "object"},
          "collector": {"type": "string", "minLength": 1},
          "relabelings": {"type": "array", "items": {"type": "object"}},
          "metricRelabelings": {"type": "array", "items": {"type": "object"}},
          "headers": {"$ref": "#/$defs/stringMap"},
          "params": {
            "type": "object",
            "description": "Probe parameter overrides. Prometheus Operator params are list-valued, so every entry is a list of strings.",
            "additionalProperties": {"type": "array", "items": {"type": "string"}}
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {"type": "boolean"},
              "type": {"enum": ["bearer", "basic"]},
              "secretName": {"type": "string"},
              "secretKey": {"type": "string"},
              "usernameKey": {"type": "string"},
              "passwordKey": {"type": "string"},
              "optional": {"type": "boolean"}
            }
          }
        },
        "required": ["name", "type"]
      }
    },

    "selfMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Rendered as --web.self-metrics-path: the one path the exporter serves its own metrics at, such as /self-metrics or /metrics. A path of plain segments that no other endpoint uses.",
          "pattern": "^(/[A-Za-z0-9._~-]*[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+$",
          "not": {"enum": ["/probe", "/health", "/ready", "/collectors", "/-/reload"]}
        },
        "enabled": {"type": "boolean"},
        "type": {"enum": ["service", "pod"], "description": "A ServiceMonitor, the default, or a PodMonitor."},
        "interval": {"$ref": "#/$defs/duration"},
        "scrapeTimeout": {"$ref": "#/$defs/duration"},
        "labels": {"$ref": "#/$defs/stringMap"},
        "annotations": {"$ref": "#/$defs/stringMap"},
        "relabelings": {"type": "array", "items": {"type": "object"}},
        "metricRelabelings": {"type": "array", "items": {"type": "object"}}
      }
    },

    "resources": {
      "type": "object",
      "properties": {
        "requests": {"$ref": "#/$defs/quantityMap"},
        "limits": {"$ref": "#/$defs/quantityMap"}
      }
    },
    "goMemLimit": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rendered as --runtime.memory-limit-ratio when enabled: the Go memory limit as a share of the container's memory limit, which the exporter reads from its cgroup. GOMEMLIMIT set in env wins.",
      "properties": {"enabled": {"type": "boolean"}, "ratio": {"type": ["number", "string"], "exclusiveMinimum": 0, "maximum": 1, "pattern": "^(0?\\.[0-9]*[1-9][0-9]*|1(\\.0*)?)$"}}
    },
    "livenessProbe": {"$ref": "#/$defs/probeTimings", "description": "Timings of the liveness probe, which checks /health on the http port."},
    "readinessProbe": {"$ref": "#/$defs/probeTimings", "description": "Timings of the readiness probe, which checks /ready on the http port."},
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "description": "An optional HorizontalPodAutoscaler for the Deployment, which then leaves replicaCount out. Every replica scrapes every static target, and exports those with export_via_otlp once per replica: keep static targets in a release without it.",
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1},
        "targetMemoryUtilizationPercentage": {"type": ["integer", "null"], "minimum": 1},
        "metrics": {"type": "array", "items": {"type": "object"}},
        "behavior": {"type": "object"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "description": "An optional PodDisruptionBudget for the exporter's pods; set minAvailable or maxUnavailable, not both.",
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string", "null"], "pattern": "^[0-9]+%?$", "minimum": 0},
        "maxUnavailable": {"type": ["integer", "string", "null"], "pattern": "^[0-9]+%?$", "minimum": 0},
        "unhealthyPodEvictionPolicy": {"type": "string", "enum": ["", "IfHealthyBudget", "AlwaysAllow"]}
      }
    },

    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["RollingUpdate", "Recreate"]},
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnavailable": {"$ref": "#/$defs/countOrPercent"},
            "maxSurge": {"$ref": "#/$defs/countOrPercent"}
          }
        }
      }
    },

    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "podLabels": {"$ref": "#/$defs/stringMap"},
    "podAnnotations": {"$ref": "#/$defs/stringMap"},
    "priorityClassName": {"type": "string"},
    "topologySpreadConstraints": {"type": "array", "items": {"type": "object", "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"]}},
    "nodeSelector": {"$ref": "#/$defs/stringMap"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {"type": "array", "items": {"type": "object"}},
        "egress": {"type": "array", "items": {"type": "object"}},
        "allowDNS": {"type": "boolean", "description": "With egress rules, also allow DNS, port 53 over UDP and TCP, to anywhere."}
      }
    },

    "targetAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"enum": ["bearer", "basic"]},
        "secretName": {"type": "string"},
        "secretKey": {"type": "string"},
        "fileName": {"type": "string"},
        "usernameKey": {"type": "string"},
        "passwordKey": {"type": "string"},
        "mountPath": {"type": "string", "pattern": "^/"},
        "usernameFileName": {"type": "string"},
        "passwordFileName": {"type": "string"}
      }
    },

    "webAuth": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mount a Secret's username and password as files for web.basic_auth.username_file and password_file.",
      "properties": {
        "enabled": {"type": "boolean"},
        "secretName": {"type": "string"},
        "usernameKey": {"type": "string", "minLength": 1},
        "passwordKey": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    }
  },

  "$defs": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "probeTimings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "successThreshold": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "terminationGracePeriodSeconds": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "quantityMap": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "countOrPercent": {"type": ["integer", "string"], "pattern": "^[0-9]+%?$"},
    "duration": {
      "type": "string",
      "description": "A Go duration such as 30s, 1m30s or 2h.",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"
    }
  }
}
