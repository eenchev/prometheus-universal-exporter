{
  "$id": "https://raw.githubusercontent.com/eenchev/prometheus-universal-exporter/main/configs/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "collectors": {
          "minItems": 1
        }
      },
      "required": [
        "collectors"
      ]
    },
    {
      "properties": {
        "collector_files": {
          "minItems": 1
        }
      },
      "required": [
        "collector_files"
      ]
    }
  ],
  "description": "The exporter configuration. See docs/CONFIGURATION.md. Collectors are defined under collectors, in the files collector_files lists, or both.",
  "patternProperties": {
    "^x-.+": {
      "description": "The file's own, ignored by the exporter: a place for YAML anchors (\u0026name) the rest of the file reuses with aliases (*name) and merge keys (\u003c\u003c: *name)."
    }
  },
  "properties": {
    "collector_files": {
      "description": "Further files of collectors, as paths or glob patterns such as collectors.d/*.yaml, relative to this file. A collector file holds a collectors list and nothing else. See docs/CONFIGURATION.md#collector-files.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "collectors": {
      "description": "The collectors. A probe names one with its collector parameter. A name must be unique across this list and every collector file.",
      "items": {
        "additionalProperties": false,
        "description": "How to reach a kind of target and turn its response into metrics.",
        "properties": {
          "cache": {
            "additionalProperties": false,
            "description": "The collector's response cache. See docs/CONFIGURATION.md#response-caching.",
            "properties": {
              "stale_if_error": {
                "description": "After ttl, keep a result this much longer to answer a probe whose trip to the target fails, marked by http_exporter_result_stale 1. Omit or 0s to answer the failure.",
                "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
                "type": "string"
              },
              "ttl": {
                "description": "Answer a repeat of the same probe from memory for this long. Omit or 0s to always go to the target.",
                "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "coalesce": {
            "description": "Share one request to the target among identical probes that arrive while it is in flight. Defaults to true.",
            "type": "boolean"
          },
          "decoder": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "description": "How to decode the response. Defaults to auto, which the transform or the Content-Type decides.",
                "enum": [
                  "auto",
                  "json",
                  "yaml",
                  "xml",
                  "csv",
                  "html",
                  "prometheus",
                  "text",
                  "graphite"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "error_handling": {
            "additionalProperties": false,
            "properties": {
              "allow_missing_keys": {
                "type": "boolean"
              },
              "on_decode_error": {
                "description": "fail stops the probe, log carries on and logs why, ignore carries on quietly. Defaults to fail.",
                "enum": [
                  "fail",
                  "log",
                  "ignore"
                ],
                "type": "string"
              },
              "on_fetch_error": {
                "description": "fail stops the probe, log carries on and logs why, ignore carries on quietly. Defaults to fail.",
                "enum": [
                  "fail",
                  "log",
                  "ignore"
                ],
                "type": "string"
              },
              "on_transform_error": {
                "description": "fail stops the probe, log carries on and logs why, ignore carries on quietly. Defaults to fail.",
                "enum": [
                  "fail",
                  "log",
                  "ignore"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "max_cache_entries": {
                "minimum": 0,
                "type": "integer"
              },
              "max_help_length": {
                "minimum": 0,
                "type": "integer"
              },
              "max_label_value_length": {
                "minimum": 0,
                "type": "integer"
              },
              "max_labels_per_metric": {
                "minimum": 0,
                "type": "integer"
              },
              "max_metric_name_length": {
                "minimum": 0,
                "type": "integer"
              },
              "max_metrics": {
                "minimum": 0,
                "type": "integer"
              },
              "max_output_bytes": {
                "description": "A size: a number of bytes, or a number with a unit such as 512KiB, 10MB or 1.5GiB.",
                "minimum": 0,
                "pattern": "^[0-9]+(\\.[0-9]+)? ?([kKmMgGtT][iI]?)?[bB]?$",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "max_response_bytes": {
                "description": "A size: a number of bytes, or a number with a unit such as 512KiB, 10MB or 1.5GiB.",
                "minimum": 0,
                "pattern": "^[0-9]+(\\.[0-9]+)? ?([kKmMgGtT][iI]?)?[bB]?$",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "max_script_memory": {
                "description": "The most memory, as address space, each of the collector's Python workers may use, the interpreter and its libraries included, such as 256MiB. A script that needs more fails with a MemoryError. At least 32MiB; 0, the default, leaves it unbounded. Enforced on Linux.",
                "minimum": 0,
                "pattern": "^[0-9]+(\\.[0-9]+)? ?([kKmMgGtT][iI]?)?[bB]?$",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "script_timeout": {
                "description": "How long a Python script may run. Starting the interpreter is not counted. Defaults to 100ms.",
                "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "max_concurrent_probes": {
            "description": "How many trips to its targets the collector makes at once; a probe over the limit is answered 503 at once, a static target waits. Omit or 0 for the default, 32.",
            "minimum": 0,
            "type": "integer"
          },
          "metrics": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "error_mode": {
                  "description": "What happens when this metric cannot be extracted. Defaults to log.",
                  "enum": [
                    "fail",
                    "log",
                    "ignore"
                  ],
                  "type": "string"
                },
                "expression": {
                  "description": "Where the value comes from, in the transform's language: jq, a regex, a CSS selector, an XPath expression, a CSV column or a source metric pattern.",
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "items": {
                  "description": "jq, yq and css only: selects the things the metric is about, such as table rows. The expression and labels are then evaluated once per item: for jq and yq with the item as . and the whole document as $root, for css as selectors within the item.",
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "labels": {
                  "items": {
                    "additionalProperties": false,
                    "description": "Set value for a static label, or expression to read it from the response.",
                    "oneOf": [
                      {
                        "required": [
                          "value"
                        ]
                      },
                      {
                        "required": [
                          "expression"
                        ]
                      }
                    ],
                    "properties": {
                      "expression": {
                        "description": "Reads the label from the response, in the transform's language, like the metric's expression.",
                        "minLength": 1,
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "name": {
                        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                        "type": "string"
                      },
                      "required": {
                        "description": "expression labels only: a series the expression gives no value, or an empty one, fails the metric under its error_mode instead of being exported without the label. Defaults to false.",
                        "type": "boolean"
                      },
                      "truncate": {
                        "description": "Cut a value longer than limits.max_label_value_length to fit, ending in …, instead of failing the scrape.",
                        "type": "boolean"
                      },
                      "value": {
                        "description": "A static label value, exported as written.",
                        "minLength": 1,
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "name": {
                  "description": "The metric name, before metrics_prefix.",
                  "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$",
                  "type": "string"
                },
                "required": {
                  "description": "When false, a missing value is skipped without an error. Defaults to true.",
                  "type": "boolean"
                },
                "scale": {
                  "description": "Multiplies the value, mapped or read as a number, such as 0.001 for milliseconds to seconds. Finite and not 0. Not for the python transform; for prometheus, plain samples only.",
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "gauge",
                    "counter",
                    "histogram",
                    "summary",
                    "untyped"
                  ],
                  "type": "string"
                },
                "value_map": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "description": "Turns the text the expression gives into the value, such as {up: 1, down: 0}; \"*\" maps any value it does not list, numbers included. Without a match and without \"*\", the value is read as a number. Not for the prometheus and python transforms.",
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "metrics_prefix": {
            "description": "Joined with _ to the front of every metric the collector exports, such as grafana for grafana_statuspage_status. Letters and digits, in parts joined by single underscores.",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:_[a-zA-Z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "description": "Unique name, used as the collector parameter of /probe.",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
            "type": "string"
          },
          "name_escaping": {
            "description": "What to do with a metric or label name that is not a classic Prometheus name, such as http.server.duration: fail the scrape (the default), replace what a classic name may not have with underscores, or use Prometheus's reversible values encoding (U__…). See docs/CONFIGURATION.md#utf-8-names.",
            "enum": [
              "fail",
              "underscores",
              "values"
            ],
            "type": "string"
          },
          "request": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "graphite"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "targets"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "grpc"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "rpc"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "localfile"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "root"
                  ]
                }
              }
            ],
            "description": "How the collector reaches its data. See docs/REQUESTS.md, docs/LOCALFILE.md for localfile, docs/GRAPHITE.md for graphite and docs/GRPC.md for grpc.",
            "properties": {
              "accept_status": {
                "description": "The HTTP statuses whose answers are decoded, such as [200, 503] or [\"2xx\", 503]; every 2xx when left out. Any other status fails the scrape in the http_status stage. An accepted status is not retried. http and graphite.",
                "items": {
                  "maximum": 599,
                  "minimum": 100,
                  "pattern": "^[1-5][xX][xX]$|^[1-5][0-9][0-9]$",
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "type": "array"
              },
              "allowed_schemes": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "allowed_targets": {
                "description": "Hosts, globs such as *.example.com, IP addresses and CIDR networks the collector's requests may reach: a target is allowed when its host matches by name, or every address it resolves to is in an allowed network. Checked before the request, on every redirect and on every connection. http, graphite and grpc.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "basic_auth": {
                "additionalProperties": false,
                "properties": {
                  "password": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "username": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "type": "object"
              },
              "basic_auth_file": {
                "additionalProperties": false,
                "properties": {
                  "password": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "username": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "type": "object"
              },
              "bearer_token": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "bearer_token_file": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "body": {
                "description": "http: the request body. May contain {{param_name}} placeholders, written as |json, |number, |form, |xml or |raw: {{param_service|json}}. See docs/REQUESTS.md#in-the-body-headers-and-query.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "denied_targets": {
                "description": "Hosts, globs, IP addresses and CIDR networks the collector's requests may not reach: a target matching by name, or resolving to any address in a denied network, is refused with 403. Wins over allowed_targets.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "descriptors": {
                "description": "grpc, required but for grpc.health.v1.Health: where the message types come from. reflection asks the server's reflection service; protoset reads protoset_file; proto compiles proto_files.",
                "enum": [
                  "reflection",
                  "protoset",
                  "proto"
                ],
                "type": "string"
              },
              "enable_http2": {
                "type": "boolean"
              },
              "files": {
                "description": "localfile: read every file of the directory whose name matches one of these patterns (path.Match syntax, no /), each checked on its own and labelled file. Not with request.path. See docs/LOCALFILE.md#reading-a-directory.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "follow_redirects": {
                "type": "boolean"
              },
              "forward_authorization": {
                "type": "boolean"
              },
              "forward_headers": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "from": {
                "description": "graphite: the start of the render window, as Graphite writes a time: -15min, the default, -1h, or Unix seconds. The from probe parameter overrides it.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "headers": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "object"
              },
              "max_age": {
                "description": "localfile: refuse a file last modified longer ago than this, so a writer that has stopped fails the scrape instead of exporting its last values forever.",
                "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
                "type": "string"
              },
              "max_files": {
                "description": "localfile with request.files: the most files one scrape reads, in name order; the rest are skipped and logged. Defaults to 100.",
                "minimum": 0,
                "type": "integer"
              },
              "max_response_bytes": {
                "description": "A size: a number of bytes, or a number with a unit such as 512KiB, 10MB or 1.5GiB.",
                "minimum": 0,
                "pattern": "^[0-9]+(\\.[0-9]+)? ?([kKmMgGtT][iI]?)?[bB]?$",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "max_total_bytes": {
                "description": "localfile with request.files: the most one scrape reads across every file; a file that would go past it is refused. Defaults to 64 MiB.",
                "minimum": 0,
                "pattern": "^[0-9]+(\\.[0-9]+)? ?([kKmMgGtT][iI]?)?[bB]?$",
                "type": [
                  "integer",
                  "string"
                ]
              },
              "message": {
                "description": "grpc: the request message in the protobuf JSON mapping. Defaults to {}. May contain {{param_name}} placeholders, written as |json for a string, |number for a number, or |raw. The message probe parameter replaces it.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "metadata": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "description": "grpc: request metadata. Keys are lower-case; -bin keys and the ones gRPC reserves are refused. Values may contain {{param_name}} placeholders.",
                "propertyNames": {
                  "pattern": "^[0-9a-z_.-]+$"
                },
                "type": "object"
              },
              "method": {
                "description": "HTTP method. Defaults to GET.",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "HEAD",
                  "get",
                  "post",
                  "put",
                  "patch",
                  "delete",
                  "head"
                ],
                "type": "string"
              },
              "path": {
                "description": "http and graphite: joined onto the target URL; it cannot hold ? or #, and query parameters go under request.query. localfile: the file, relative to request.root and joined after the target. May contain {{param_name}} or {{param_name:default}} path parameters, filled by param_\u003cname\u003e probe parameters.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "proto_files": {
                "description": "grpc with descriptors: proto: the .proto files that define the service, compiled when the configuration loads and again when one changes.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "proto_import_paths": {
                "description": "grpc with descriptors: proto: the directories imports are resolved in, as protoc -I. Defaults to the directory of each file. The well-known types are built in.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "protoset_file": {
                "description": "grpc with descriptors: protoset: a FileDescriptorSet with its imports, as protoc --descriptor_set_out --include_imports or buf build -o writes it. Read again when it changes.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "query": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "object"
              },
              "retry": {
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "backoff": {
                    "description": "A duration such as 500ms, 30s or 5m.",
                    "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
                    "type": "string"
                  },
                  "codes": {
                    "description": "grpc: the gRPC status codes that are retried, by name, such as [UNAVAILABLE, ABORTED]. Defaults to [UNAVAILABLE]; OK is refused.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "non_idempotent": {
                    "description": "http and graphite: retry a request whose method is not idempotent, such as POST, which sending again may repeat. Unset, only GET, HEAD, OPTIONS, TRACE, PUT and DELETE requests are retried.",
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "root": {
                "description": "localfile, required: the absolute directory the collector may read files under. No read reaches outside it, through .. or a symbolic link. See docs/LOCALFILE.md.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "rpc": {
                "description": "grpc, required: the method called, package.Service/Method, such as grpc.health.v1.Health/Check. See docs/GRPC.md.",
                "pattern": "^/?([A-Za-z_][A-Za-z0-9_]*\\.)*[A-Za-z_][A-Za-z0-9_]*/[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              },
              "targets": {
                "description": "graphite, required: the Graphite expressions asked of the render API, each sent as a target parameter, such as app.*.requests.count. May contain {{param_name}} placeholders, filled with letters, digits and _ - . : @ % + ~ only. See docs/GRAPHITE.md.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "tls": {
                "additionalProperties": false,
                "properties": {
                  "ca_file": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "cert_file": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "insecure_skip_verify": {
                    "type": "boolean"
                  },
                  "key_file": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "server_name": {
                    "description": "The name the target's certificate is checked against, and sent as SNI, when the target is addressed by something else, such as an IP address. Unset, the target's host.",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "type": "object"
              },
              "type": {
                "description": "Required. How the collector reaches its data.",
                "enum": [
                  "graphite",
                  "grpc",
                  "http",
                  "localfile"
                ],
                "type": "string"
              },
              "until": {
                "description": "graphite: the end of the render window. Defaults to now. The until probe parameter overrides it.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          "response": {
            "additionalProperties": false,
            "properties": {
              "charset": {
                "description": "The encoding of the response when the target does not declare it or declares it wrongly, and of local files: a WHATWG name such as windows-1252, iso-8859-2, windows-1251 or shift_jis. See docs/CONFIGURATION.md#character-encodings.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "csv": {
                "additionalProperties": false,
                "properties": {
                  "delimiter": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "header": {
                    "type": "boolean"
                  },
                  "trim_space": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "graphite": {
                "additionalProperties": false,
                "properties": {
                  "invalid_lines": {
                    "description": "graphite decoder: what a carbon line that cannot be read does: fail the decode, the default, or skip, leaving it out, counted in http_exporter_decoder_lines_skipped_total and logged.",
                    "enum": [
                      "fail",
                      "skip"
                    ],
                    "type": "string"
                  },
                  "max_age": {
                    "description": "graphite decoder: leave out a series whose newest point is older than this, so a series nobody writes any more is not exported with its last value.",
                    "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
                    "type": "string"
                  },
                  "value": {
                    "description": "graphite decoder: how a series' points become its value: last, the newest point, by default, or max, min, avg or sum.",
                    "enum": [
                      "last",
                      "max",
                      "min",
                      "avg",
                      "sum"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "namespaces": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "transform": {
            "additionalProperties": false,
            "properties": {
              "exclude": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "include": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "labels": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "object"
              },
              "libraries": {
                "items": {
                  "description": "A bundled Python library the script uses. Declared libraries are imported when the interpreter starts.",
                  "enum": [
                    "PyYAML",
                    "dateutil",
                    "lxml",
                    "python-dateutil",
                    "yaml"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "pre_script": {
                "description": "Python run before the transform. It receives data and must leave its result in data.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "remove_labels": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "array"
              },
              "rename": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "object"
              },
              "rename_labels": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": "object"
              },
              "required_libs": {
                "items": {
                  "description": "A bundled Python library the script uses. Declared libraries are imported when the interpreter starts.",
                  "enum": [
                    "PyYAML",
                    "dateutil",
                    "lxml",
                    "python-dateutil",
                    "yaml"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "script": {
                "description": "Python for the python transform. It emits metrics with metric(...).",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": {
                "description": "How metrics are extracted from the decoded response. Required.",
                "enum": [
                  "jq",
                  "yq",
                  "xpath",
                  "css",
                  "csv",
                  "regex",
                  "python",
                  "prometheus"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        },
        "required": [
          "name",
          "request",
          "transform"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "otlp": {
      "additionalProperties": false,
      "properties": {
        "compression": {
          "description": "Compression of the export requests. Defaults to gzip.",
          "enum": [
            "gzip",
            "none"
          ],
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "description": "OTLP/HTTP metrics endpoint, such as http://otel-collector:4318/v1/metrics.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "insecure_skip_verify": {
          "type": "boolean"
        },
        "interval": {
          "description": "A duration such as 500ms, 30s or 5m.",
          "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "max_pending_points": {
          "description": "The most data points kept waiting for export while the endpoint fails; past it the oldest are dropped and counted. Defaults to 100000.",
          "minimum": 0,
          "type": "integer"
        },
        "probe_attributes": {
          "description": "Add collector and target attributes to the points a probe queues, so probes of different targets or collectors answering the same series are exported apart. Off, the default, the later probe's point replaces the earlier's.",
          "type": "boolean"
        },
        "resource_attributes": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "service_name": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "timeout": {
          "description": "How long one export attempt may take. Defaults to 5s. Also bounds the last export at shutdown.",
          "pattern": "^[-+]?(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string"
        },
        "tls": {
          "additionalProperties": false,
          "properties": {
            "ca_file": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "cert_file": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "insecure_skip_verify": {
              "type": "boolean"
            },
            "key_file": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "server_name": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "type": "object"
        },
        "unready_after_failures": {
          "description": "Answer /ready with 503 after this many failed exports in a row, until one gets through. 0, the default, never does: an exporter whose exports fail still answers probes.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "web": {
      "additionalProperties": false,
      "properties": {
        "basic_auth": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "password": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "password_file": {
              "description": "Read the password from this file instead of password, such as a mounted Secret. Read again when it changes.",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "username": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "username_file": {
              "description": "Read the username from this file instead of username, such as a mounted Secret. Read again when it changes.",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "type": "object"
        },
        "self_metrics": {
          "additionalProperties": false,
          "properties": {
            "resource_metrics_enabled": {
              "type": "boolean"
            },
            "verbose": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "title": "prometheus-universal-exporter configuration",
  "type": "object"
}
